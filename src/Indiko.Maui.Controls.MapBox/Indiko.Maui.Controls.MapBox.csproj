<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>

		<!-- NuGet -->
		<Authors>INDIKO</Authors>
		<Copyright>Copyright © INDIKO and contributors</Copyright>
		<IsPackable>True</IsPackable>
		<PackageProjectUrl>https://github.com/0xc3u/Indiko.Maui.Controls.MapBox</PackageProjectUrl>
		<RepositoryUrl>https://github.com/0xc3u/Indiko.Maui.Controls.MapBox</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>dotnet-maui;maui;ui;map;mapbox;control</PackageTags>
		<IncludeSymbols>True</IncludeSymbols>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Title>INDIKO .NET MAUI Mapbox View</Title>
		<Description>Native Mapbox map control for .NET MAUI applications. Renders the Mapbox Maps SDK v11 natively on Android and iOS through a thin facade binding, exposing styles, camera control, markers, user location and gesture configuration as a bindable MAUI view.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<!--
	  The binding projects are not packable — their assemblies (plus the native AARs /
	  the iOS resources sidecar) are packed INTO this package via PackBindingOutputs
	  below. PrivateAssets=all keeps them out of the nuspec dependency list.
	-->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ProjectReference Include="..\Indiko.Maui.Controls.MapBox.Bindings.Android\Indiko.Maui.Controls.MapBox.Bindings.Android.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<ProjectReference Include="..\Indiko.Maui.Controls.MapBox.Bindings.iOS\Indiko.Maui.Controls.MapBox.Bindings.iOS.csproj" PrivateAssets="all" />
	</ItemGroup>

	<!--
	  The Android binding's Java dependencies must still flow to consumers as regular
	  NuGet dependencies (PrivateAssets=all above suppresses the transitive flow).
	  Keep these versions in sync with Bindings.Android.csproj.
	-->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.2.0.1" />
		<PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.10.2.1" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.1" />
		<PackageReference Include="Square.OkHttp3" Version="4.12.0.4" />
		<PackageReference Include="GoogleGson" Version="2.13.1.1" />
	</ItemGroup>

	<PropertyGroup>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackBindingOutputs</TargetsForTfmSpecificBuildOutput>
		<!-- NuGet drops non-default extensions from the lib folder — the native AARs and
		     the iOS binding resources sidecar must survive the filter. -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.aar;.zip</AllowedOutputExtensionsInPackageBuildOutputFolder>
	</PropertyGroup>

	<Target Name="PackBindingOutputs" DependsOnTargets="Build">
		<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
			<BuildOutputInPackage Include="$(OutputPath)Indiko.Maui.Controls.MapBox.Bindings.Android.dll" />
			<BuildOutputInPackage Include="$(OutputPath)*.aar" />
		</ItemGroup>
		<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
			<BuildOutputInPackage Include="$(OutputPath)Indiko.Maui.Controls.MapBox.Bindings.iOS.dll" />
			<BuildOutputInPackage Include="$(OutputPath)Indiko.Maui.Controls.MapBox.Bindings.iOS.resources.zip" />
		</ItemGroup>
	</Target>

</Project>
